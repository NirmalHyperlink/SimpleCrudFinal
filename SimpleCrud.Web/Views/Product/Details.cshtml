@model SimpleCrud.Models.DTOs.ProductDto

@{
    ViewData["Title"] = "Product Details";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0 fw-bold">
                    <i class="bi bi-info-circle me-2"></i>Product Details
                </h4>
                <span class="badge bg-light text-primary fs-6">ID: #@Model.Id</span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Product Name</dt>
                    <dd class="col-sm-8 fw-semibold fs-5">@Model.Name</dd>

                    <dt class="col-sm-4 text-muted">Description</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</dd>

                    <dt class="col-sm-4 text-muted">Price</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6">
                            @Model.Price.ToString("C")
                        </span>
                    </dd>

                    <dt class="col-sm-4 text-muted">Created Date</dt>
                    <dd class="col-sm-8">
                        <i class="bi bi-calendar3 me-1"></i>@(Model.CreatedDate?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")
                    </dd>

                    <dt class="col-sm-4 text-muted">Last Updated</dt>
                    <dd class="col-sm-8">
                        <i class="bi bi-calendar-check me-1"></i>@(Model.UpdatedDate?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Never")
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-light p-3 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i> Edit Product
                </a>
            </div>
        </div>
    </div>
</div>
