@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 bg-white rounded-3 shadow-sm border">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold text-primary mb-3">
            <i class="bi bi-layers-half me-2"></i>Simple ASP.NET Core 8 MVC CRUD
        </h1>
        <p class="col-md-10 fs-5 text-secondary">
            A clean, interview-friendly ASP.NET Core 8 MVC application built with <strong>Database-First EF Core</strong>, 
            <strong>Repository Pattern</strong>, <strong>Service Layer</strong>, <strong>AutoMapper</strong>, 
            <strong>DTOs</strong>, and <strong>JWT Authentication</strong> stored in secure HttpOnly cookies.
        </p>

        <div class="d-flex gap-3 mt-4">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-grid me-2"></i>Go to Products
                </a>
                <a asp-controller="Product" asp-action="Create" class="btn btn-outline-primary btn-lg px-4">
                    <i class="bi bi-plus-circle me-2"></i>Create Product
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Login
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg px-4">
                    <i class="bi bi-person-plus me-2"></i>Register
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-4 py-2">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="text-primary mb-3 fs-2"><i class="bi bi-database-check"></i></div>
                <h5 class="card-title fw-bold">Database First</h5>
                <p class="card-text text-muted">
                    Database and tables are designed first in SQL Server. DbContext and Models are scaffolded via EF Core CLI tools without code-first migrations.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="text-primary mb-3 fs-2"><i class="bi bi-diagram-3"></i></div>
                <h5 class="card-title fw-bold">Repository & Service Layer</h5>
                <p class="card-text text-muted">
                    Clear separation of concerns: Repository handles database access & soft deletes, Service handles business logic & mapping, Controllers remain thin.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="text-primary mb-3 fs-2"><i class="bi bi-shield-lock"></i></div>
                <h5 class="card-title fw-bold">JWT Authentication</h5>
                <p class="card-text text-muted">
                    Standard JWT tokens are generated on login, stored in HttpOnly cookies, and validated via ASP.NET Core Bearer middleware for protected Razor views.
                </p>
            </div>
        </div>
    </div>
</div>
